{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:*:*:log-group:/aws/lambda/askai-*"
    },
    {
      "Sid": "CallClaude",
      "Effect": "Allow",
      "Action": [
        "bedrock:InvokeModel",
        "bedrock:InvokeModelWithResponseStream"
      ],
      "Resource": [
        "arn:aws:bedrock:*::foundation-model/anthropic.claude-opus-5-5*",
        "arn:aws:bedrock:*:*:inference-profile/global.anthropic.claude-opus-5-5*"
      ]
    },
    {
      "Sid": "SearchTheHelpArticles",
      "Effect": "Allow",
      "Action": "bedrock:Retrieve",
      "Resource": "arn:aws:bedrock:*:*:knowledge-base/*"
    },
    {
      "Sid": "RerankSearchResults",
      "Effect": "Allow",
      "Action": "bedrock:InvokeModel",
      "Resource": "arn:aws:bedrock:*::foundation-model/cohere.rerank-v3-5:0"
    },
    {
      "Sid": "RerankApi",
      "Effect": "Allow",
      "Action": "bedrock:Rerank",
      "Resource": "*"
    }
  ]
}
